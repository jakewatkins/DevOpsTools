{
    "AppName": "SRE Test Function",
    "AZURE_FUNCTIONS_ENVIRONMENT": "dev",
    "IsEncrypted": false,
    "Values": {
        "AzureWebJobsStorage": "UseDevelopmentStorage=true",
        "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated"
    },
    "Grpc": {
        "ChannelUri": "http://localhost:7200"
    },
    "ConnectionStrings": {
        "TestConfiguration" : "DefaultEndpointsProtocol=https;AccountName=jkwfiles;AccountKey=/l35gl7COW6HBMZE4US5Uxj5iDCM+fn876KiUaUMt9svJO+5Kw6GigKTjtqtTeblkAKPrQVXlXvO0KXPzA1LbA==;EndpointSuffix=core.windows.net"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Serilog": {
        "Using": [ "Serilog.Sinks.NewRelic.Logs", "NewRelic.LogEnrichers.Serilog" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Information",
                "System": "Information",
                "Microsoft.AspNetCore": "Information"
            }
        },
        "WriteTo": [
            {
                "Name": "NewRelicLogs",
                "Args": {
                    "Application": "sre-monitor-test-funv-dev",
                    "applicationName": "sre-monitor-test-funv-dev"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "log-.txt",
                    "rollingInterval": "Day",
                    "rollOnFileSizeLimit": true,
                    "fileSizeLimitBytes": 10485760, // 10 MB
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level}] {Message}{NewLine}{Exception}"
                }
            }
        ],
        "Enrich": [ "WithNewRelicLogsInContext", "FromLogContext", "WithMachineName", "WithThreadId" ],
        "rollingInterval": "Day",
        "Properties": {
            "Application": "sre-monitor-test-funv-dev",
            "applicationName": "sre-monitor-test-funv-dev"
        }
    }
}

